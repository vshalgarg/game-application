pipeline {

    agent any

    environment {
        APP_NAME      = 'game-service-prod'
        IMAGE_NAME    = 'game-service-prod'
        REMOTE_PATH   = "${E2E_REMOTE_PATH_BASE}/${APP_NAME}"
        SSH_USER      = "${E2E_SSH_USER}"
        SSH_HOST      = "${E2E_SSH_HOST}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build JAR') {
            steps {
				sh '''
					chmod +x mvnw
                	./mvnw clean package -DskipTests
				'''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Save Docker Image') {
            steps {
                sh "docker save ${IMAGE_NAME}:latest -o ${IMAGE_NAME}.tar"
            }
        }
	      stage('Transfer Docker Image') {
            steps {
			        withCredentials([sshUserPrivateKey(credentialsId: 'e2e-ssh', keyFileVariable: 'SSH_KEY')]) {
  			        sh """
  			            ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no "$SSH_USER@$SSH_HOST" "mkdir -p '$REMOTE_PATH'"
  			            rsync -avz --progress -e "ssh -i \\"$SSH_KEY\\" -o StrictHostKeyChecking=no" "${IMAGE_NAME}.tar" "$SSH_USER@$SSH_HOST:$REMOTE_PATH/"
  			        """
			      }
			     }
        }

        stage('Run Container') {
            steps {
                withCredentials([string(
                  credentialsId: 'TIC_TAC_TOE_SUPABASE_SECRET_KEY_DEV',
                  variable: 'TIC_TAC_TOE_SUPABASE_SECRET_KEY_DEV')
                ]) {

                    sh """
                      ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no $SSH_USER@$SSH_HOST << 'EOF'
                      cd $REMOTE_PATH
                      docker load -i ${IMAGE_NAME}.tar
                      docker stop ${IMAGE_NAME} || true
                      docker rm ${IMAGE_NAME} || true
                      docker run -d --name ${IMAGE_NAME} \\
                          --network backend-net \\
                          -e SPRING_PROFILES_ACTIVE=prod \\
                          -e supabase.api-key="$TIC_TAC_TOE_SUPABASE_SECRET_KEY_DEV" \
                          --restart unless-stopped \\
                          ${IMAGE_NAME}:latest
                      EXIT 0
                      EOF
                    """
                }
            }
        }

        stage('Clean Old Images') {
            steps {
                sh '''
                    docker image prune -f
                '''
            }
        }
    }
}
