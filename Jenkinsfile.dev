pipeline {
  agent any
  tools {
        nodejs 'Node 24'
    }

  environment {
    IMAGE_NAME = "game-application-ui"
    CONTAINER_NAME = "game-application-ui"
    PORT = "8092"
    BUILD_MODE = 'development'
  }

  parameters {
      string(name: 'BRANCH_NAME', defaultValue: 'game-ui-dev', description: 'Branch to build')
  }
  
  stages {
    stage('Checkout') {
        steps {
          echo "Checking out from git from branch ${params.BRANCH_NAME}"
            git branch: "${params.BRANCH_NAME}",
                url: 'git@github.com:vshalgarg/game-application.git'
        }
    }

    stage('Build Docker Image') {
      steps {
        echo "🐳 Building Docker image..."
        sh 'docker build --build-arg BUILD_MODE=$BUILD_MODE -t $IMAGE_NAME .'
      }
    }

    stage('Stop Old Container') {
      steps {
        echo "🛑 Stopping and removing old container if it exists..."
        sh '''
          docker stop $CONTAINER_NAME || true
          docker rm $CONTAINER_NAME || true
        '''
      }
    }

    stage('Run New Container') {
      steps {
          echo "🚀 Running new container on port $PORT..."
          sh '''
            docker run -d \
              --name $CONTAINER_NAME \
              --restart unless-stopped \
              -p $PORT:80 \
              $IMAGE_NAME
          '''
        }
      }
    }
  }

  post {
    success {
      echo "✅ Deployment successful! game-application-ui running on port $PORT"
    }
    failure {
      echo "❌ Deployment failed. Check build logs."
    }
  }
}
