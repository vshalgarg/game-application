pipeline {

    agent any

    environment {

        IMAGE_NAME = "vshalgargnpl/api-gateway"
        TAG = "latest"
        CONTAINER_NAME = "game-service"
        PORT_MAPPING = "8091:8091"
        REGISTRY = "index.docker.io/v1/"
    }

    parameters {

        string(
                name: 'BRANCH_NAME',
                defaultValue: 'api-gateway-dev',
                description: 'Branch to build'
        )
    }

    stages {

        stage('Checkout') {

            steps {

                echo 'Checking out api-gateway source code'
                git branch: "${params.BRANCH_NAME}",
                        url: 'git@github.com:vshalgarg/game-application.git'
            }
        }

        stage('Build Jar') {
            steps {
                echo 'Building api-gateway jar'
                sh '''
                    chmod +x mvnw
                    ./mvnw clean package -DskipTests
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image'
                sh '''
                    docker build -t "$IMAGE_NAME:$TAG" .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                script {

                    docker.withRegistry(
                            "https://${REGISTRY}",
                            'docker-credentials-id'
                    ) {
                        def appImage = docker.build("${IMAGE_NAME}:${TAG}")
                        appImage.push()
                    }
                }
            }
        }

        stage('Stop Existing Container') {
            steps {
                sh '''
                    docker stop "$CONTAINER_NAME" || true
                    docker rm "$CONTAINER_NAME" || true
                '''
            }
        }


        stage('Run Container') {

            steps {
                sh '''
                    docker run -d \
                      --name "$CONTAINER_NAME" \
                      -p "$PORT_MAPPING" \
                      --restart unless-stopped \
                      --network game-network \
                      -e SPRING_PROFILES_ACTIVE=dev \
                      -v /var/log/tic-tac-toe-engine:/logs \
                      "$IMAGE_NAME:$TAG"
                '''
            }
        }

        stage('Clean Old Images') {
            steps {
                sh '''
                    docker image prune -f
                '''
            }
        }
    }
}